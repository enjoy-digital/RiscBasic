10 REM GUESS THE NUMBER - TINY BASIC DEMO FOR THE TEG1015 BOARD
20 REM THE LEDS SHOW HOW CLOSE THE GUESS IS
30 G=&HF8015004
40 PRINT "Guess my number from 1 to 100"
50 PRINT "Press a key to start"
60 R=R+1: K=KEY: IF K=0 THEN 60
70 N=(RND(100)+R) MOD 100+1: T=0
80 INPUT "Your guess";A
90 T=T+1: D=ABS(A-N)
100 IF D=0 THEN 200
110 L=15: IF D>5 THEN L=7
120 IF D>15 THEN L=3
130 IF D>40 THEN L=1
140 POKE G,L
150 IF A<N THEN PRINT "Higher!"
160 IF A>N THEN PRINT "Lower!"
170 GOTO 80
200 PRINT "Right, it is ";N;" - found in ";T;" tries"
210 FOR I=1 TO 8: POKE G,15*(I MOD 2): DELAY 150: NEXT I
220 INPUT "Again (1 = yes)";A
230 IF A=1 THEN 40
240 POKE G,0: PRINT "Bye"
